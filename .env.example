# ---------------------------------------------------------------------------
# Copy to .env for local development. On Vercel, add each of these under
# Settings → Environment Variables. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# REQUIRED — MongoDB Atlas connection string.
# Atlas → Database → Connect → Drivers. Replace <password> with the real one
# and keep the /skflip database name before the "?".
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/skflip?retryWrites=true&w=majority

# REQUIRED — signing key for session tokens. The server refuses to start in
# production without it. Generate a fresh one:
#   openssl rand -base64 48
# Changing this value signs everyone out, which is exactly what you want if it
# has ever been exposed.
JWT_SECRET=

# How long a session lasts. 7d, 30d, 12h all work.
JWT_EXPIRES_IN=7d

# RECOMMENDED — the account that gets admin rights on signup.
# Without this, the first account ever created becomes admin, which is a race
# worth avoiding on a public deployment.
ADMIN_EMAIL=you@example.com

# Password reset email (Gmail). EMAIL_PASS must be an App Password, not your
# normal password: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification on the account.
# Leave blank to disable password reset; the rest of the app works fine.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Display name used in emails.
BRAND_NAME=SkFlip

# Comma-separated origins allowed to call the API from a browser. Leave blank
# while the frontend is served from the same domain as the API. Set it if you
# ever split them or add a mobile app.
# ALLOWED_ORIGINS=https://skflip.com,https://www.skflip.com
